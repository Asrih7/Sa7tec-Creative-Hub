# EmailJS configuration for the Contact form
# Create an EmailJS service and template, then copy these values into .env.local.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Optional client-side rate limit
VITE_CONTACT_FORM_RATE_LIMIT=5
VITE_CONTACT_FORM_RATE_WINDOW=3600000

# Example template variables used by Contact.tsx:
# {{to_email}}, {{to_name}}, {{name}}, {{email}}, {{reply_to}},
# {{project_type}}, {{budget_range}}, {{message}}, {{sent_at}}, {{website}}
