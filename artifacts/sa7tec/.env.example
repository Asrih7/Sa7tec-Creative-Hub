# SA7TEC Environment Configuration Example
# Copy this file to .env and fill in your actual values

# API Configuration
VITE_API_URL=https://api.sa7tec.com
VITE_API_TIMEOUT=30000

# Security
VITE_ENABLE_CSP=true
VITE_CSP_REPORT_URI=https://sa7tec.com/api/csp-report
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,sa7tec.com
VITE_ADMIN_INITIAL_PASSWORD=change-this-before-deployment

# EmailJS Contact Form
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Analytics (Optional)
VITE_ANALYTICS_ID=
VITE_ENABLE_ANALYTICS=false

# Feature Flags
VITE_ENABLE_ADMIN=true
VITE_ENABLE_GAMES=true
VITE_ENABLE_CONTACT_FORM=true

# Rate Limiting
VITE_CONTACT_FORM_RATE_LIMIT=5
VITE_CONTACT_FORM_RATE_WINDOW=3600000

# Production Deployment
VITE_APP_ENV=production
VITE_BUILD_TIME=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
